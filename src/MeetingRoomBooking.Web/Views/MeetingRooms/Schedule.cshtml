@model MeetingRoomBooking.Web.Models.TimeSlots.RoomScheduleViewModel

@{
    ViewData["Title"] = $"{Model.Room.Name} schedule";
}

<div class="mb-4">
    <a asp-controller="MeetingRooms"
       asp-action="Index"
       class="btn btn-outline-secondary btn-sm mb-3">
        Back to rooms
    </a>

    <h1>@Model.Room.Name</h1>

    <p class="text-muted">
        @(Model.Room.Description ?? "No description provided.")
    </p>

    <p>
        <strong>Capacity:</strong> @Model.Room.Capacity
    </p>
</div>

<form asp-controller="MeetingRooms"
      asp-action="Schedule"
      asp-route-id="@Model.Room.Id"
      method="get"
      class="row g-3 align-items-end mb-4">

    <div class="col-sm-4">
        <label asp-for="Date" class="form-label">
            Date (UTC)
        </label>
        <input asp-for="Date"
               type="date"
               asp-format="{0:yyyy-MM-dd}"
               name="date"
               required
               class="form-control" />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            Show schedule
        </button>
    </div>
</form>

<p class="text-muted">
    All times below are in UTC.
</p>

@if (Model.Slots.Count == 0)
{
    <div class="alert alert-info">
        No time slots are configured for this date.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Start (UTC)</th>
                <th scope="col">End (UTC)</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in Model.Slots)
            {
                <tr>
                    <td>@slot.StartUtc.ToString("HH:mm")</td>
                    <td>@slot.EndUtc.ToString("HH:mm")</td>
                    <td>
                        @if (slot.IsBooked)
                        {
                            <span class="badge bg-danger">Booked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Free</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}