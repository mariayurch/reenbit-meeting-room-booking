@model MeetingRoomBooking.Web.Models.TimeSlots.RoomScheduleViewModel

@{
    ViewData["Title"] = $"{Model.Room.Name} schedule";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

@if (ViewData["BookingError"] is string bookingError)
{
    <div class="alert alert-danger" role="alert">
        @bookingError
    </div>
}

<div class="mb-4">
    <a asp-controller="MeetingRooms"
       asp-action="Index"
       class="btn btn-outline-secondary btn-sm mb-3">
        Back to rooms
    </a>

    <h1>@Model.Room.Name</h1>

    <p class="text-muted">
        @(Model.Room.Description ?? "No description provided.")
    </p>

    <p>
        <strong>Capacity:</strong> @Model.Room.Capacity
    </p>
</div>

<form asp-controller="MeetingRooms"
      asp-action="Schedule"
      asp-route-id="@Model.Room.Id"
      method="get"
      class="row g-3 align-items-end mb-4">

    <div class="col-sm-4">
        <label asp-for="Date" class="form-label">
            Date (UTC)
        </label>
        <input asp-for="Date"
               type="date"
               asp-format="{0:yyyy-MM-dd}"
               name="date"
               required
               class="form-control" />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            Show schedule
        </button>
    </div>
</form>

<p class="text-muted">
    All times below are in UTC.
</p>

<p id="realtime-status"
   class="text-muted"
   role="status"
   data-room-id="@Model.Room.Id"
   data-hub-url="@Url.Content("~/hubs/room-schedule")"
   data-date="@(Model.Date.ToString("yyyy-MM-dd"))">
    Connecting to live updates…
</p>

@if (Model.Slots.Count == 0)
{
    <div class="alert alert-info">
        No time slots are configured for this date.
    </div>
}
else
{
    <form asp-controller="Bookings"
          asp-action="Create"
          asp-route-meetingRoomId="@Model.Room.Id"
          method="post">

        <input type="hidden"
               name="date"
               value="@Model.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />

        <p>
            Select one slot or several consecutive slots,
            then click Book selected slots.
            Slots that have already started cannot be booked.
        </p>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Select</th>
                    <th scope="col">Start (UTC)</th>
                    <th scope="col">End (UTC)</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in Model.Slots)
                {
                    <tr data-slot-id="@slot.Id">
                        <td>
                            @if (!slot.IsBooked)
                            {
                                <input type="checkbox"
                                       name="TimeSlotIds"
                                       value="@slot.Id"
                                       class="form-check-input"
                                       aria-label="@($"Select slot {slot.StartUtc:HH:mm}–{slot.EndUtc:HH:mm} UTC")" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@slot.StartUtc.ToString("HH:mm")</td>
                        <td>@slot.EndUtc.ToString("HH:mm")</td>
                        <td>
                            @if (slot.IsBooked)
                            {
                                <span class="badge bg-danger">
                                    Booked
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Free
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">
            Book selected slots
        </button>
    </form>
}

@section Scripts
{
    <script src="~/lib/signalr/signalr.min.js"
            asp-append-version="true"></script>

    <script src="~/js/room-schedule.js"
            asp-append-version="true"></script>
}