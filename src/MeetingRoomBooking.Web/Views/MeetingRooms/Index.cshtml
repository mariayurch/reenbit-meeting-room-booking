@model IReadOnlyList<MeetingRoomBooking.Application.MeetingRooms.Models.MeetingRoomListItem>

@{
    ViewData["Title"] = "Meeting rooms";
}

<div class="mb-4">
    <p class="text-primary fw-semibold mb-2">
        Rooms
    </p>

    <h1 class="fw-bold mb-2">
        Meeting rooms
    </h1>

    <p class="text-muted mb-0">
        Choose a meeting room to view its schedule and available time slots.
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        <strong>No meeting rooms available.</strong>
        There are currently no active rooms that can be booked.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="h5 card-title fw-bold mb-0">
                                @room.Name
                            </h2>

                            <span class="badge text-bg-light">
                                @room.Capacity @(room.Capacity == 1 ? "person" : "people")
                            </span>
                        </div>

                        <p class="card-text text-muted flex-grow-1">
                            @(room.Description ?? "No description provided.")
                        </p>

                        <a asp-route="MeetingRoomSchedule"
                           asp-route-id="@room.Id"
                           class="btn btn-primary mt-3">
                            View schedule
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
}