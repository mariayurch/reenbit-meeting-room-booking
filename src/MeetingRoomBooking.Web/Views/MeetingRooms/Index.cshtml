@model IReadOnlyList<MeetingRoomBooking.Application.MeetingRooms.Models.MeetingRoomListItem>

@{
    ViewData["Title"] = "Meeting rooms";
}

<div class="mb-4">
    <h1>Available meeting rooms</h1>
    <p class="text-muted">
        Select a meeting room to view its schedule.
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No meeting rooms are currently available.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">
                            @room.Name
                        </h2>

                        <p class="card-text text-muted flex-grow-1">
                            @(room.Description ?? "No description provided.")
                        </p>

                        <p class="card-text mb-0">
                            <strong>Capacity:</strong>
                            @room.Capacity
                        </p>

                        <a asp-route="MeetingRoomSchedule"
                        asp-route-id="@room.Id"
                        class="btn btn-primary mt-3">
                            View schedule
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}