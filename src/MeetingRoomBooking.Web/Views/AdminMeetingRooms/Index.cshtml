@model IReadOnlyList<MeetingRoomBooking.Application.MeetingRooms.Models.MeetingRoomListItem>

@{
    ViewData["Title"] = "Meeting rooms";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Meeting rooms</h1>
        <p class="text-muted mb-0">
            Manage the meeting rooms available for booking.
        </p>
    </div>

    <a asp-controller="AdminMeetingRooms"
       asp-action="Create"
       class="btn btn-primary">
        Create room
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No meeting rooms have been created yet.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Capacity</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@(room.Description ?? "—")</td>
                    <td>@room.Capacity</td>
                    <td>
                        @if (room.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}