@{
    ViewData["Title"] = "Admin";
}

<div class="mb-4">
    <p class="text-primary fw-semibold mb-2">
        Administration
    </p>

    <h1 class="fw-bold mb-2">
        Admin dashboard
    </h1>

    <p class="text-muted mb-0">
        Manage meeting rooms, schedules and booking availability.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">

                <h2 class="h5 fw-bold">
                    Meeting rooms
                </h2>

                <p class="text-muted flex-grow-1">
                    Create new rooms, edit their details
                    or remove rooms that are no longer available.
                </p>

                <a asp-controller="AdminMeetingRooms"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage rooms
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column p-4">

                <h2 class="h5 fw-bold">
                    Bookings
                </h2>

                <p class="text-muted flex-grow-1">
                    View all bookings across users,
                    including rooms, times and statuses.
                </p>

                <a asp-controller="AdminBookings"
                asp-action="Index"
                class="btn btn-primary">
                    View bookings
                </a>

            </div>
        </div>
    </div>
</div>